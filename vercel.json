{
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo start --web",
  "installCommand": "npm install",
  "framework": null,
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/(.+)$", "dest": "/api/[...path]?...path=$1", "check": true },
    { "src": "^/(.*)", "dest": "/" }
  ]
}
